# >>> mst2-cluster-nav (own HMI bundle, appended: no stock class is shadowed)
# Guard, run on every HMI start. Each check can only make this HMI start without the mod; none
# stops the script. Tools by absolute path (IFS /bin, system /usr/bin): no PATH is assumed.
MCN=/tsd/var/mst2-cluster-nav
MCN_CPU=/tsd/etc/system/cpu.conf
MCN_OFF=
for d in /media/mp00?; do
  [ -e $d/mst2-cluster-nav-disable ] && MCN_OFF="kill switch on $d"
done
# The HMI starts again on this boot, and the mod was in it but had not settled (1 min): the mod
# may be the cause, so it stays off until it is enabled again in GEM.
if [ -e /dev/shmem/mst2-cluster-nav-on -a ! -e /dev/shmem/mst2-cluster-nav-hmi-ok ]; then
  MCN_OFF="the HMI restarted before the mod settled"
  /bin/rm -f $MCN/enabled $MCN/trial
fi
# The toolbox's "dual navigation" patch replaces stock HMI classes, and its restore copies an old
# runHMI.sh over this block; Install refuses it, this catches it added later. Active only with its
# jar present and a line outside this block (the block names the jar) that is not a comment.
if [ -e /tsd/hmi/HMI/jar/NavActiveIgnore.jar ] &&
    /usr/bin/sed '/^# >>> mst2-cluster-nav/,/^# <<< mst2-cluster-nav/d' /tsd/hmi/runHMI.sh |
    /usr/bin/grep -v '^[ 	]*#' | /usr/bin/grep 'NavActiveIgnore.jar' > /dev/null; then
  MCN_OFF="the toolbox dual navigation patch is active"
fi
# A library in LD_PRELOAD that cannot be loaded keeps SAL or DisplayManager from starting (the
# unit then resets): if one is missing, empty or not an ARM shared library, take every one of
# ours out of cpu.conf. The new cpu.conf keeps the old one's mode, must equal the old one with our
# entries removed, and reaches the disk before the partition goes back to read-only.
MCN_FIX=
for MCN_F in $(/usr/bin/sed -n 's#.*\(/tsd/[a-z]*/mst2-cluster-nav/[^: ]*\).*#\1#p' $MCN_CPU); do
  case $(/usr/bin/od -A n -t x1 -N 20 $MCN_F 2>/dev/null |
      /usr/bin/awk '{ for (i = 1; i <= NF; i++) s = s $i } END { print s }') in
    7f454c460101????????????????????03002800) ;;
    *) MCN_FIX="$MCN_F missing, empty or not an ARM library" ;;
  esac
done
if [ -n "$MCN_FIX" ]; then
  MCN_OFF="$MCN_FIX: removed from cpu.conf"
  if /bin/mount -t qnx6 -o remount,rw /dev/hd0t177 /; then
    MCN_SED='\#^   envar LD_PRELOAD /tsd/[a-z]*/mst2-cluster-nav/[^:]*$#d
s#:/tsd/[a-z]*/mst2-cluster-nav/[^: ]*##g'
    /bin/cp -p $MCN_CPU $MCN_CPU.mcn && /usr/bin/sed -e "$MCN_SED" $MCN_CPU > $MCN_CPU.mcn &&
      /usr/bin/sed -e "$MCN_SED" $MCN_CPU > /dev/shmem/mst2-cluster-nav-cpu.conf &&
      /usr/bin/cmp -s $MCN_CPU.mcn /dev/shmem/mst2-cluster-nav-cpu.conf &&
      [ -s $MCN_CPU.mcn ] && /bin/mv -f $MCN_CPU.mcn $MCN_CPU
    /bin/rm -f $MCN_CPU.mcn /dev/shmem/mst2-cluster-nav-cpu.conf
    /bin/sync
    /bin/mount -t qnx6 -o remount,ro /dev/hd0t177 /
  fi
  /bin/rm -f $MCN/enabled $MCN/trial
fi
# HMI crash mark: made below when the mod goes into this HMI start, removed by the bundle once it
# has settled (1 min). Found here, the last start with the mod did not settle: the HMI or the
# whole unit went down first. That counts only when the mark is younger than 3 minutes (the unit
# came straight back; a reset loop does) and the HMI-restart check above has not already turned
# the mod off for it: a normal switch-off within the first minute leaves an old mark, and one
# event never counts twice. Two such starts in a row turn the mod off; a settled start clears
# the count.
if [ -e $MCN/hmi-busy ]; then
  MCN_T=
  read MCN_T < $MCN/hmi-busy
  MCN_NOW=$(/bin/date -t)
  case "$MCN_T$MCN_NOW" in
    *[!0-9]*) MCN_T= ;;
  esac
  if [ -z "$MCN_OFF" -a -n "$MCN_T" -a -n "$MCN_NOW" ] && [ $((MCN_NOW - MCN_T)) -ge 0 ] &&
      [ $((MCN_NOW - MCN_T)) -lt 180 ]; then
    MCN_N=0
    [ -e $MCN/hmi-strikes ] && read MCN_N < $MCN/hmi-strikes
    case "$MCN_N" in
      ''|*[!0-9]*) MCN_N=0 ;;
    esac
    MCN_N=$((MCN_N + 1))
    echo $MCN_N > $MCN/hmi-strikes
    if [ $MCN_N -ge 2 ]; then
      MCN_OFF="the HMI did not settle twice"
      /bin/rm -f $MCN/enabled $MCN/trial
    fi
  fi
  /bin/rm -f $MCN/hmi-busy
else
  /bin/rm -f $MCN/hmi-strikes
fi
if [ -n "$MCN_OFF" ]; then
  echo "mst2-cluster-nav: off ($MCN_OFF)"
  echo "$MCN_OFF" > $MCN/off-reason 2>/dev/null
  # Off for the native hooks too, from their next check (2 s), not only from the next boot.
  /usr/bin/touch /dev/shmem/mst2-cluster-nav-off
  /bin/rm -f /dev/shmem/mst2-cluster-nav-on /dev/shmem/mst2-cluster-nav-trial
elif [ -s $MCN/mst2-cluster-nav.jar ] &&
    { [ -e $MCN/enabled -o -e /dev/shmem/mst2-cluster-nav-trial ] ||
      [ -e $MCN/trial -a ! -e /dev/shmem/mst2-cluster-nav-armed ]; }; then
  # A native part may have taken the trial already (/dev/shmem/mst2-cluster-nav-trial); a
  # trial armed by GEM on this boot (-armed) is the next boot's.
  [ -e /dev/shmem/mst2-cluster-nav-armed ] || /bin/rm -f $MCN/trial
  /bin/rm -f /dev/shmem/mst2-cluster-nav-off
  # Tells the native hooks (SAL, DisplayManager) that the mod runs on this boot.
  /usr/bin/touch /dev/shmem/mst2-cluster-nav-on
  /bin/date -t > $MCN/hmi-busy
  BOOTCLASSPATH="$BOOTCLASSPATH:$MCN/mst2-cluster-nav.jar"
fi
# <<< mst2-cluster-nav
